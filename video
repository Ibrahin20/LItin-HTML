css
/* --- HERO CON VIDEO --- */
.hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden; /* Corta lo que sobre del video */
    margin-top: 0; /* Si el navbar es transparente, el video puede ir detrás */
}

.video-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2; /* Al fondo de todo */
}

.video-bg {
    width: 100%;
    height: 100%;
    object-fit: cover; /* El secreto para que el video no se estire */
}

.overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 51, 102, 0.6); /* Azul institucional con transparencia */
    z-index: -1; /* Encima del video, debajo del texto */
}

.hero-content {
    z-index: 1;
    text-align: center;
    color: var(--white);
    padding: 0 20px;
}